ninja_required_version = 1.7
cxx = clang++
flags = -std=c++17 -pthread -fms-extensions -Wno-multichar -Wno-abstract-final-class -DGLM_FORCE_SWIZZLE -DGLM_FORCE_DEPTH_ZERO_TO_ONE -DIMGUI_DISABLE_WIN32_FUNCTIONS -DDR_FLAC_NO_STDIO -DDR_MP3_NO_STDIO -DDR_WAV_NO_STDIO -O0 -g -DCOMFY_DEBUG '-I/home/terulmia/Downloads/Project Diva/ComfyChartEditor/source/build/linux-debug/generated' '-I/home/terulmia/Downloads/Project Diva/ComfyChartEditor/source/ComfyLib/src' '-I/home/terulmia/Downloads/Project Diva/ComfyChartEditor/source/ComfyEngine/src' '-I/home/terulmia/Downloads/Project Diva/ComfyChartEditor/source/ComfyStudio/src' '-I/home/terulmia/Downloads/Project Diva/ComfyChartEditor/source/Dependencies/glm/include' '-I/home/terulmia/Downloads/Project Diva/ComfyChartEditor/source/Dependencies/stb/include' '-I/home/terulmia/Downloads/Project Diva/ComfyChartEditor/source/Dependencies/rapidjson/include' '-I/home/terulmia/Downloads/Project Diva/ComfyChartEditor/source/Dependencies/iconfont/include' '-I/home/terulmia/Downloads/Project Diva/ComfyChartEditor/source/Dependencies/dr_libs/include' '-I/home/terulmia/Downloads/Project Diva/ComfyChartEditor/source/Dependencies/discord_game_sdk/include' -I/usr/include/SDL2 -D_GNU_SOURCE=1 -D_REENTRANT -DWITH_GZFILEOP
libraries = -lSDL2 -lGLEW -lX11 -lGLU -lOpenGL -lGL -lssl -lcrypto -lz -lvorbisfile -lvorbisenc -lvorbis -logg -lavformat -lavcodec -lswscale -lavutil -ldl -pthread
rule compile
  command = $cxx $flags -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $in
rule archive
  command = ar rcs $out $in
rule link
  command = $cxx $in $libraries -o $out
  description = LINK $out
rule pack_data
  command = ./ComfyDataBuild -build_comfy_data '/home/terulmia/Downloads/Project Diva/ComfyChartEditor/source/ComfyData/data-src' $out
  description = PACK $out
